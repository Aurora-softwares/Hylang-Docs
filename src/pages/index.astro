---
import hylo from '../assets/hylo/hello.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf7ff" />
    <meta name="description" content="Meet Hydrogen: a friendly introduction to the language, with beginner guides, downloadable examples, and full documentation." />
    <meta property="og:title" content="Hydrogen — Make something wonderful" />
    <meta property="og:description" content="Start learning Hydrogen with welcoming guides, examples, and documentation." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Welcome to Hydrogen — Learn, create, explore</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="haze-background" aria-hidden="true"><div class="haze-blob one"></div><div class="haze-blob two"></div><div class="haze-blob three"></div></div>
    <div class="page-shell">
      <header class="topbar glass">
        <a class="brand" href="/" aria-label="Hydrogen home"><img src="/favicon.svg" alt="" width="38" height="38" /><span>Hydrogen<span class="brand-point">.</span></span></a>
        <nav aria-label="Main navigation">
          <a href="/docs/">Documentation</a>
          <a href="#guides">How-to guides</a>
          <a href="#samples">Sample projects</a>
          <a class="github-link" href="https://github.com/Aurora-softwares/Hylang-Compiler" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> A little language with big ideas</p>
            <h1 id="hero-title">Hello, <span class="gradient-word">Hydrogen.</span><br />Let's make something wonderful.</h1>
            <p class="intro">Welcome to a friendly place to learn Hydrogen. Whether you're writing your first line of code or exploring operating systems, you'll find clear guides, practical examples, and room to experiment.</p>
            <div class="hero-actions">
              <a class="button primary" href="/getting-started/installing/">Get started <span aria-hidden="true">→</span></a>
              <a class="button secondary" href="/docs/">Explore the docs <span aria-hidden="true">↗</span></a>
            </div>
            <p class="release-note">New here? Start with the <a href="/getting-started/current-release/">published release</a>. More experimental features are documented separately.</p>
          </div>
          <div class="hero-art" aria-label="A simple Hydrogen Hello World program">
            <span class="art-spark spark-one" aria-hidden="true">✳</span>
            <span class="art-spark spark-two" aria-hidden="true">✦</span>
            <div class="code-card glass">
              <div class="code-top"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>hello.hy</span><span class="language-mark">HY</span></div>
              <pre><code><span class="purple">public class</span> <span class="blue">Program</span> {
  <span class="purple">public static int</span> Main(
      <span class="blue">string</span>[] args) {
    System.Console.WriteLine(
      <span class="green">"Hello, Hydrogen!"</span>);
    <span class="purple">return</span> <span class="orange">0</span>;
  }
}</code></pre>
              <div class="terminal"><span class="terminal-label">OUTPUT</span><span class="terminal-prompt">❯</span> Hello, Hydrogen! <span class="terminal-cursor" aria-hidden="true"></span></div>
            </div>
            <div class="hero-sticker glass"><img src={hylo.src} width={hylo.width} height={hylo.height} alt="Hylo, the friendly Hydrogen mascot" /><span>You've got this! <span aria-hidden="true">✧</span></span></div>
          </div>
        </section>

        <section class="welcome-note glass" aria-label="What is Hydrogen">
          <div class="note-icon" aria-hidden="true">✳</div>
          <div><h2>What's Hydrogen?</h2><p>A C#-inspired programming language built by Aurora Softwares. Start with native programs on Linux, and explore ongoing work toward Windows, macOS, and Australis OS. You don't need to understand operating systems to begin.</p></div>
          <a href="/language/structure/" aria-label="Learn about Hydrogen's language structure">Learn more <span aria-hidden="true">→</span></a>
        </section>

        <section class="section-block" id="guides" aria-labelledby="guides-heading">
          <div class="section-heading"><p class="section-kicker">A good place to begin</p><h2 id="guides-heading">Learn at your own pace <span aria-hidden="true">✿</span></h2><p>Small steps, plain language, and just enough detail to get you building.</p></div>
          <div class="guide-grid">
            <a class="feature-card peach glass" href="/getting-started/installing/"><span class="feature-symbol" aria-hidden="true">↓</span><span class="card-small">01 · GET READY</span><h3>Install Hydrogen</h3><p>Find the right release, set things up, and make sure you're ready to code.</p><span class="card-arrow">Start here <span aria-hidden="true">→</span></span></a>
            <a class="feature-card lilac glass" href="/getting-started/running/"><span class="feature-symbol" aria-hidden="true">{ }</span><span class="card-small">02 · SAY HELLO</span><h3>Your first program</h3><p>Write a tiny Hello World program and see it come to life.</p><span class="card-arrow">Follow the guide <span aria-hidden="true">→</span></span></a>
            <a class="feature-card mint glass" href="/tools/projects/"><span class="feature-symbol" aria-hidden="true">▧</span><span class="card-small">03 · BUILD MORE</span><h3>Make a project</h3><p>Learn how files and project manifests fit together as your ideas grow.</p><span class="card-arrow">Explore projects <span aria-hidden="true">→</span></span></a>
          </div>
        </section>

        <section class="section-block" id="samples" aria-labelledby="samples-heading">
          <div class="section-heading"><p class="section-kicker">Pick a starting point</p><h2 id="samples-heading">Little projects to make your own</h2><p>Download real Hydrogen source files, open them in your editor, and try changing something. These beginner examples use features documented for the published Linux release.</p></div>
          <div class="sample-grid">
            <article class="sample-card glass"><div class="sample-preview pink" aria-hidden="true"><span>01</span><strong>Hello, world! <em>✳</em></strong></div><div class="sample-content"><span class="sample-level">Beginner · One file</span><h3>Say hello</h3><p>Your first runnable program. Learn where code starts and how to print a message.</p><a href="/samples/hello.hy" download>Download hello.hy <span aria-hidden="true">↓</span></a></div></article>
            <article class="sample-card glass"><div class="sample-preview lavender" aria-hidden="true"><span>02</span><strong>1, 2, 3… <em>✦</em></strong></div><div class="sample-content"><span class="sample-level">Beginner · One file</span><h3>Count along</h3><p>Explore variables and loops with a tiny program that counts to five.</p><a href="/samples/count-to-five.hy" download>Download count-to-five.hy <span aria-hidden="true">↓</span></a></div></article>
            <article class="sample-card glass"><div class="sample-preview aqua" aria-hidden="true"><span>03</span><strong>Hello, you! <em>♡</em></strong></div><div class="sample-content"><span class="sample-level">Beginner · One file</span><h3>Personal greeting</h3><p>Pass a name on the command line and let your application say hello.</p><a href="/samples/greet-you.hy" download>Download greet-you.hy <span aria-hidden="true">↓</span></a></div></article>
          </div>
          <div class="sample-footer"><p>Need a hand running them? <a href="/samples/">See the example instructions</a>.</p><a href="https://github.com/Aurora-softwares/Hylang-Compiler/tree/Development/samples" target="_blank" rel="noopener noreferrer">Explore development examples <span aria-hidden="true">↗</span></a></div>
        </section>

        <section class="docs-section glass" aria-labelledby="docs-heading">
          <div class="docs-copy"><p class="section-kicker">Everything in one place</p><h2 id="docs-heading">Your curiosity, meet the docs.</h2><p>Browse the language guide, look up types and syntax, or explore the compiler, projects, and runtime. Straightforward explanations are always a click away.</p><a class="button primary" href="/docs/">Open documentation <span aria-hidden="true">→</span></a></div>
          <div class="docs-links" aria-label="Documentation shortcuts">
            <a href="/language/structure/"><span aria-hidden="true">◇</span><span><strong>Language basics</strong><small>Structure, types, loops, and methods</small></span><span aria-hidden="true">↗</span></a>
            <a href="/tools/hydrogen/"><span aria-hidden="true">⌘</span><span><strong>Compiler &amp; tools</strong><small>Commands, projects, and output</small></span><span aria-hidden="true">↗</span></a>
            <a href="/tools/desktop-ui/"><span aria-hidden="true">▣</span><span><strong>Desktop UI (development)</strong><small>Experimental native interfaces</small></span><span aria-hidden="true">↗</span></a>
            <a href="/roadmap/"><span aria-hidden="true">✧</span><span><strong>What's next?</strong><small>Follow Hydrogen's roadmap</small></span><span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="closing"><span aria-hidden="true">✳</span><h2>Every great project starts somewhere.</h2><p>Start small, try things out, and enjoy making something new.</p><a class="button secondary" href="/getting-started/running/">Write your first program <span aria-hidden="true">→</span></a></section>
      </main>
      <footer class="footer"><span><img src="/favicon.svg" width="24" height="24" alt="" /> Hydrogen by <a href="https://github.com/Aurora-softwares">Aurora Softwares</a></span><span><a href="/docs/">Documentation</a><a href="https://github.com/Aurora-softwares/Hylang-Compiler">GitHub</a><a href="/roadmap/">Roadmap</a></span></footer>
    </div>
  </body>
</html>

<style is:global>
  :root{color-scheme:light;--ink:#302b46;--muted:#666179;--purple:#7660c7;--outline:rgba(110,91,145,.16);--glass:rgba(255,255,255,.7)}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fbf9ff;line-height:1.62}a{color:inherit}a:focus-visible{outline:3px solid #7861ca;outline-offset:4px;border-radius:5px}.skip-link{position:absolute;left:1rem;top:-5rem;z-index:20;background:white;padding:1rem;border-radius:12px}.skip-link:focus{top:1rem}
  .haze-background{pointer-events:none;position:absolute;inset:0 0 auto;min-height:1000px;overflow:hidden;z-index:0;background:radial-gradient(ellipse 55% 48% at 5% 18%,#fce8e6 0,transparent 78%),radial-gradient(ellipse 50% 60% at 88% 15%,#e7dfff 0,transparent 79%),radial-gradient(ellipse 38% 33% at 63% 76%,#e0f6f2 0,transparent 90%),#fbf9ff}.haze-blob{position:absolute;border-radius:36% 64% 65% 35%/42% 45% 55% 58%;filter:blur(4px);opacity:.54}.haze-blob.one{width:340px;height:280px;top:130px;left:-160px;background:linear-gradient(130deg,#ffdbcf,#fceafb);transform:rotate(23deg)}.haze-blob.two{width:480px;height:440px;right:-190px;top:190px;background:linear-gradient(125deg,#cddafc,#e8d0fc);transform:rotate(-16deg)}.haze-blob.three{width:270px;height:230px;top:740px;right:22%;background:#d5f3ed;opacity:.35}
  .page-shell{position:relative;z-index:1;max-width:1250px;padding:24px clamp(22px,5vw,54px) 0;margin:0 auto}.glass{background:var(--glass);border:1px solid rgba(255,255,255,.9);box-shadow:0 12px 46px rgba(72,62,103,.07),inset 0 0 0 1px rgba(129,113,160,.08);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}.topbar{min-height:78px;border-radius:26px;display:flex;align-items:center;justify-content:space-between;padding:14px 24px;gap:24px}.brand{text-decoration:none;display:flex;align-items:center;gap:10px;font-size:1.4rem;font-weight:850;letter-spacing:-.05em}.brand-point{color:#9a7de0}.topbar nav{display:flex;align-items:center;flex-wrap:wrap;gap:clamp(14px,2.6vw,33px)}.topbar nav a{text-decoration:none;color:#534d68;font-weight:650;font-size:.91rem}.topbar nav a:hover,.footer a:hover{color:#7654b9}.topbar nav .github-link{padding:9px 16px;border:1px solid #dfd2f5;border-radius:100px;background:#f5eeff}
  .hero{min-height:655px;padding:104px 0 74px;display:grid;grid-template-columns:minmax(0,1.14fr) minmax(0,1fr);gap:26px;align-items:center}.eyebrow,.section-kicker{margin:0 0 18px;text-transform:uppercase;letter-spacing:.14em;font-size:.76rem;color:#8a64b8;font-weight:800}.eyebrow{display:flex;align-items:center;gap:9px}.eyebrow-dot{width:9px;height:9px;background:#db9fc8;border-radius:50%}.hero h1{max-width:680px;font-size:clamp(2.9rem,5vw,5rem);line-height:1.09;letter-spacing:-.067em;font-weight:850;margin:0 0 24px}.gradient-word{background:linear-gradient(105deg,#c275a6,#8c71d7 62%,#66a6ba);background-clip:text;-webkit-background-clip:text;color:transparent}.intro{font-size:1.08rem;color:var(--muted);max-width:570px;margin:0 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:50px;padding:12px 23px;border-radius:100px;font-weight:750;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.button:hover{transform:translateY(-2px)}.button.primary{background:#7865c6;color:white;box-shadow:0 9px 24px rgba(109,86,192,.2)}.button.secondary{background:rgba(255,255,255,.68);border:1px solid #dcd0ef;color:#594790}.release-note{font-size:.82rem;color:#7f768a;margin:22px 0 0}.release-note a{color:#7759bb;text-underline-offset:3px}
  .hero-art{position:relative;min-width:0;padding:34px 0 45px}.code-card{position:relative;z-index:2;max-width:540px;border-radius:24px;overflow:hidden;background:rgba(255,255,255,.84);transform:rotate(1.5deg);box-shadow:0 20px 75px rgba(73,63,123,.12)}.code-top{display:flex;align-items:center;gap:15px;padding:14px 19px;border-bottom:1px solid #eae2f5;font-weight:700;color:#6c6383;font-size:.8rem}.window-dots{display:flex;gap:5px}.window-dots i{display:block;width:9px;height:9px;border-radius:50%;background:#f3b8b8}.window-dots i:nth-child(2){background:#f5d6a5}.window-dots i:nth-child(3){background:#b9dfcd}.language-mark{margin-left:auto;background:#f3ecff;border-radius:9px;padding:3px 9px;color:#8467c3}.code-card pre{font:500 clamp(.75rem,1.2vw,.92rem)/1.9 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre;overflow:auto;margin:0;padding:22px 24px;color:#45415e}.code-card .purple{color:#996cc8}.code-card .blue{color:#598bb8}.code-card .green{color:#5c9a81}.code-card .orange{color:#c58a50}.terminal{padding:17px 20px;background:#f5f0fa;border-top:1px solid #e9e0f3;font:500 .82rem/1.8 ui-monospace,Consolas,monospace;color:#46405d}.terminal-label{display:block;letter-spacing:.12em;font:700 .63rem/1.6 inherit;color:#9e92b4;margin-bottom:5px}.terminal-prompt{color:#9474d5}.terminal-cursor{display:inline-block;width:7px;height:13px;background:#a899c0;vertical-align:middle}.hero-sticker{position:absolute;z-index:3;bottom:-4px;right:-9px;display:flex;flex-direction:column;align-items:center;gap:0;width:143px;padding:13px 8px 11px;border-radius:26px;transform:rotate(-8deg);font-weight:800;font-size:.77rem;color:#8262ac;background:rgba(255,255,255,.9)}.hero-sticker img{width:99px;height:98px;object-fit:contain}.art-spark{position:absolute;color:#a698e7;font-size:3.5rem}.spark-one{top:-20px;right:34px}.spark-two{bottom:-23px;left:36px;color:#dfa6b4;font-size:2.7rem}
  .welcome-note{display:flex;align-items:center;gap:22px;border-radius:25px;padding:22px 28px;background:rgba(255,255,255,.78)}.note-icon{flex:0 0 52px;height:52px;display:grid;place-items:center;border-radius:17px;background:#eee6ff;color:#9870c7;font-size:2rem}.welcome-note h2{font-size:1.2rem;letter-spacing:-.03em;margin:0 0 3px}.welcome-note p{color:var(--muted);margin:0;font-size:.93rem}.welcome-note>a{flex-shrink:0;margin-left:20px;font-size:.86rem;font-weight:750;color:#8060bc;text-decoration:none}
  .section-block{padding-top:126px;scroll-margin-top:30px}.section-heading{margin:0 0 31px}.section-heading h2,.docs-copy h2,.closing h2{font-size:clamp(2rem,3.5vw,3rem);line-height:1.13;letter-spacing:-.055em;margin:0 0 13px}.section-heading h2 span{font-size:.78em;color:#cf9cbb}.section-heading>p:last-child{margin:0;color:var(--muted);max-width:680px}.guide-grid,.sample-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.feature-card{border-radius:26px;display:flex;flex-direction:column;text-decoration:none;padding:25px;min-height:300px;transition:transform .2s ease,box-shadow .2s ease}.feature-card:hover,.sample-card:hover{transform:translateY(-5px);box-shadow:0 18px 46px rgba(90,72,127,.12)}.feature-card.peach{background:linear-gradient(145deg,#ffefea,#fff9f6)}.feature-card.lilac{background:linear-gradient(145deg,#f0eafe,#fcfaff)}.feature-card.mint{background:linear-gradient(145deg,#e3f6f1,#f6fcfa)}.feature-symbol{width:53px;height:53px;border-radius:16px;display:grid;place-items:center;background:rgba(255,255,255,.75);color:#8d74c5;font-weight:750;font-size:1.5rem;margin-bottom:23px}.card-small{font-size:.68rem;font-weight:800;letter-spacing:.13em;color:#86748e}.feature-card h3{font-size:1.4rem;line-height:1.2;letter-spacing:-.035em;margin:7px 0 9px}.feature-card p{font-size:.9rem;color:#645f77;margin:0 0 22px}.card-arrow{margin-top:auto;color:#7759ae;font-size:.86rem;font-weight:800}
  .sample-card{background:rgba(255,255,255,.81);overflow:hidden;border-radius:24px;transition:transform .2s ease,box-shadow .2s ease}.sample-preview{min-height:147px;padding:18px 22px;display:flex;flex-direction:column;justify-content:space-between}.sample-preview.pink{background:linear-gradient(125deg,#fae1e3,#fcefeb)}.sample-preview.lavender{background:linear-gradient(130deg,#ded8fa,#f2ebff)}.sample-preview.aqua{background:linear-gradient(125deg,#d1eee9,#edfbf6)}.sample-preview>span{font-size:.8rem;color:#84788d;font-weight:750}.sample-preview strong{font-size:1.5rem;letter-spacing:-.05em}.sample-preview em{font-style:normal;font-size:2rem;color:#b08bc1}.sample-content{padding:22px}.sample-level{color:#937aaf;font-weight:800;font-size:.72rem;letter-spacing:.05em}.sample-content h3{font-size:1.3rem;letter-spacing:-.03em;margin:5px 0 8px}.sample-content p{color:var(--muted);font-size:.9rem;min-height:85px;margin:0 0 16px}.sample-content a{display:inline-flex;gap:7px;align-items:center;color:#6e53b1;text-decoration:none;font-weight:800;font-size:.84rem}.sample-content a:hover{text-decoration:underline}.sample-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:20px;color:var(--muted);font-size:.88rem}.sample-footer p{margin:0}.sample-footer a{color:#7855b8;text-underline-offset:3px}
  .docs-section{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:40px;border-radius:34px;padding:clamp(28px,5vw,60px);margin-top:128px;background:linear-gradient(115deg,rgba(239,230,255,.93),rgba(251,250,255,.9) 50%,rgba(227,246,244,.9))}.docs-copy p:not(.section-kicker){color:var(--muted);margin:0 0 27px}.docs-links{display:flex;flex-direction:column;gap:11px}.docs-links a{display:grid;grid-template-columns:42px 1fr 18px;gap:13px;align-items:center;border:1px solid rgba(137,118,169,.14);background:rgba(255,255,255,.74);border-radius:17px;padding:14px;text-decoration:none}.docs-links a>span:first-child{background:#f4edff;color:#8467ba;width:42px;height:42px;border-radius:13px;display:grid;place-items:center;font-size:1.5rem}.docs-links a strong{display:block;font-size:.9rem}.docs-links a small{display:block;font-size:.77rem;color:#716b7e}.docs-links a>span:last-child{font-weight:800;color:#8d75c0}.docs-links a:hover{background:white}
  .closing{text-align:center;padding:120px 20px 100px}.closing>span{font-size:2.9rem;color:#b7a7e8}.closing h2{margin-top:6px}.closing p{margin:0 0 26px;color:var(--muted)}.footer{padding:25px 0 35px;border-top:1px solid #e7e0f0;display:flex;align-items:center;justify-content:space-between;gap:15px;color:#746b85;font-size:.82rem}.footer>span{display:flex;align-items:center;flex-wrap:wrap;gap:10px}.footer a{text-decoration:none}
